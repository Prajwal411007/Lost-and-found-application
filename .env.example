# Supabase Public Keys (Required for Frontend and Client Queries)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-Only Secret Key (NEVER expose to frontend code!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server Port & URLs
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Optional Email Provider (Resend) - In-app notifications will function without this
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@example.com

